{
	auto_https off
}

:8080 {
	root * /srv/site
	encode zstd gzip

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	@rootCert path /root.crt
	handle @rootCert {
		root * /srv/caddy-data/caddy/pki/authorities/local
		header Content-Disposition "attachment; filename=\"lab-skywt-caddy-root.crt\""
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	file_server
}
