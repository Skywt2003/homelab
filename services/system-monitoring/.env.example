# Legacy placeholder only. Do not put real secrets in this repository.
# MIHOMO_API_TOKEN is now managed in Infisical path /system-monitoring and
# materialized to /run/homelab/secrets/system-monitoring/mihomo_api_token.
# The PVE API token value is stored as PVE_TOKEN_VALUE in the same Infisical
# path and materialized as pve_token_value.
#
# See docs/secret-management-sop.md and scripts/materialize-secrets.sh.
MIHOMO_API_TOKEN=<managed-in-infisical>
PVE_TOKEN_VALUE=<managed-in-infisical>
