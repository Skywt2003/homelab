      "targets": [
        {
          "expr": "mihomo_traffic_download_speed_bytes",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
