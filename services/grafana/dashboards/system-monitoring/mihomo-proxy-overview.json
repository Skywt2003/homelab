        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total traffic 24h",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "increase(mihomo_traffic_download_total_bytes[24h]) + increase(mihomo_traffic_upload_total_bytes[24h])",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unavailable proxies",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(mihomo_proxy_available == 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Global traffic speed",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mihomo_traffic_download_speed_bytes",
          "legendFormat": "download",
          "refId": "A"
        },
        {
          "expr": "mihomo_traffic_upload_speed_bytes",
          "legendFormat": "upload",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Traffic by outbound node",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(mihomo_connection_download_bytes_by_node[1m])) by (outbound_node)",
          "legendFormat": "{{outbound_node}} down",
          "refId": "A"
        },
        {
          "expr": "sum(rate(mihomo_connection_upload_bytes_by_node[1m])) by (outbound_node)",
          "legendFormat": "{{outbound_node}} up",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Current selected proxy nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "expr": "mihomo_proxy_group_selected",
          "legendFormat": "{{group}} → {{proxy}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "group": "Group",
              "proxy": "Selected proxy",
              "type": "Group type"
            }
          }
        }
      ],
      "description": "Current Mihomo proxy-group selections reported by mihomo_proxy_group_selected from the proxy host."
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Selected proxy node timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "expr": "mihomo_proxy_group_selected",
          "legendFormat": "{{group}} · {{proxy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "rowHeight": 0.9,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Full-width, taller timeline of the proxy node selected by each Mihomo proxy group. Labels are shortened and bar values are hidden to improve readability."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Selected proxy latency history",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "mihomo_selected_proxy_latency_ms",
          "legendFormat": "{{group}} → {{proxy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Latency history only for nodes that are currently selected by Mihomo proxy groups."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Selected proxy error rate (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "(1 - avg_over_time(mihomo_selected_proxy_available[5m])) and on(group, proxy, type) mihomo_proxy_group_selected",
          "legendFormat": "{{group}} → {{proxy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Rolling 5 minute probe failure ratio, gated by the proxy group selection at each evaluation time so stale post-switch series are hidden."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Selected proxy latency jitter (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "stddev_over_time(clamp_min(mihomo_selected_proxy_latency_ms, 0)[5m:]) and on(group, proxy, type) mihomo_proxy_group_selected",
          "legendFormat": "{{group}} → {{proxy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Rolling 5 minute standard deviation of latency, gated by the proxy group selection at each evaluation time so stale post-switch series are hidden."
    },
    {
      "id": 14,
      "type": "table",
      "title": "All proxy availability and latency",
      "datasource": {
        "type": "prometheus",
        "uid": "system-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "mihomo_proxy_available",
          "legendFormat": "available",
          "refId": "A"
        },
        {
          "expr": "mihomo_proxy_latency_ms",
          "legendFormat": "latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "description": "Current availability and latency for all probed Mihomo proxy nodes."
    }
  ]
}
