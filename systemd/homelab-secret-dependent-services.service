[Unit]
Description=Materialize homelab secrets and restore dependent Docker Compose services
Documentation=file:/home/skywt/homelab/docs/secret-management-sop.md
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=HOMELAB_ROOT=/home/skywt/homelab
Environment=INFISICAL_WAIT_SECONDS=300
Environment=COMPOSE_START_TIMEOUT_SECONDS=180
ExecStart=/home/skywt/homelab/scripts/restore-secret-dependent-services.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
